        y: 0px;
    }
    Image {
        height: 24px;
        image-fit: fill;
        image-rendering: pixelated;
        source: Assets.polygon-1;
        transform-origin: { x: 0px, y: 0px };
        transform-rotation: 90deg;
        width: 24px;
        x: 29px;
        y: 6px;
    }
}

export enum BackProperty1 { default }
export component Back inherits Rectangle {
    in property <BackProperty1> variant-property-1: BackProperty1.default;
