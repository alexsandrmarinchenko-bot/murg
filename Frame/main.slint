// import "fonts/inter-regular.ttf";

global Assets {
    out property <image> biblioteca: @image-url("assets/image-d81a3bd1d543f942.png");
    out property <image> icon: @image-url("assets/image-99c1e7fe16e3ea5d.png");
    out property <image> unnamed: @image-url("assets/image-49194f4ab8df0950.png");
    out property <image> unnamed-2: @image-url("assets/image-a71d83b2d743a058.png");
}

export component Bibleoteka inherits Rectangle {
    preferred-width: 31px;
    preferred-height: 31px;
    Image {
        height: 31px;
        image-fit: fill;
        image-rendering: pixelated;
        source: Assets.biblioteca;
        width: 31px;
        x: 0px;
        y: 0px;
    }
    Rectangle {
        height: 17px;
        width: 20px;
        x: 5px;
        y: 7px;
        Image {
            height: 18.401px;
            image-fit: fill;
            source: Assets.icon;
            width: 21.648px;
            x: -0.53px;
            y: -0.701px;
        }
    }
}

export component Unnamed inherits Rectangle {
    preferred-width: 68px;
    preferred-height: 23px;
    Image {
        height: 5px;
        image-fit: fill;
        image-rendering: pixelated;
        source: Assets.unnamed;
        width: 68px;
        x: 0px;
        y: 9px;
    }
    Image {
        height: 23px;
        image-fit: fill;
        image-rendering: pixelated;
        source: Assets.unnamed-2;
        width: 23px;
        x: 3px;
        y: 0px;
    }
}

export component ShkalaVremeni inherits Rectangle {
    preferred-width: 1106px;
    preferred-height: 23px;
    Rectangle {
        background: #D9D9D9;
        height: 5px;
        width: 1106px;
        x: 0px;
        y: 9px;
    }
    Rectangle {
        background: #D9D9D9;
        border-radius: 4px;
        height: 23px;
        width: 23px;
        x: 3px;
        y: 0px;
    }
}

export component Demo inherits Window {
    width: 1280px;
    height: 720px;
    background: transparent;
    Rectangle {
        background: #202020;
        clip: true;
        Rectangle {
            x: 25px;
            y: 598px;
            width: 1229px;
            height: 96px;
            Rectangle {
                x: 0px;
                y: 0px;
                width: 96px;
                height: 96px;
                background: #D9D9D9;
                border-radius: 10px;
            }
            Rectangle {
                x: 123px;
                y: 23.5px;
                width: 1106px;
                height: 72.5px;
                FlexboxLayout {
                    flex-direction: column;
                    flex-wrap: no-wrap;
                    spacing: 1px;
                    cross-axis-alignment: start;
                    ShkalaVremeni {
                        preferred-width: 1106px;
                        min-width: 0px;
                        cross-axis-self-alignment: stretch;
                        horizontal-stretch: 0;
                        height: 23px;
                    }
                    Rectangle {
                        preferred-width: 1106px;
                        min-width: 0px;
                        cross-axis-self-alignment: stretch;
                        horizontal-stretch: 0;
                        height: 48.5px;
                        Rectangle {
                            x: 0px;
                            y: 10.5px;
                            width: 112px;
                            height: 38px;
                            FlexboxLayout {
                                flex-wrap: no-wrap;
                                spacing: 6px;
                                cross-axis-alignment: center;
                                Unnamed {
                                    width: 68px;
                                    height: 23px;
                                }
                                Image {
                                    width: 38px;
                                    height: 38px;
                                    source: @image-url("assets/image-a7524bd04a5d9478.png");
                                    image-fit: fill;
                                    image-rendering: pixelated;
                                }
                            }
                        }
                        Rectangle {
                            x: 526px;
                            y: 0px;
                            width: 135px;
                            height: 41px;
                            Image {
                                x: 0px;
                                y: 5px;
                                width: 31px;
                                height: 31px;
                                source: @image-url("assets/image-ad9b5a6d06da7dec.png");
                                image-fit: fill;
                                image-rendering: pixelated;
                            }
                            Image {
                                x: 46px;
                                y: 0px;
                                width: 43px;
                                height: 41px;
                                source: @image-url("assets/image-9e45c6515b00fe78.png");
                                image-fit: fill;
                                image-rendering: pixelated;
                            }
                            Image {
                                x: 104px;
                                y: 5px;
                                width: 31px;
                                height: 31px;
                                source: @image-url("assets/image-8c4553e8b0d341b7.png");
                                image-fit: fill;
                                image-rendering: pixelated;
                            }
                        }
                        Image {
                            x: 1075px;
                            y: 10px;
                            width: 31px;
                            height: 31px;
                            source: @image-url("assets/image-d81a3bd1d543f942.png");
                            image-fit: fill;
                            image-rendering: pixelated;
                        }
                    }
                }
            }
        }
        Rectangle {
            x: 25px;
            y: 548px;
            width: 162px;
            height: 23px;
            figma-overflow-1-measure := Text {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                opacity: 0;
                color: #C3C3C3;
                text: "название трека";
                font-family: "Inter";
                font-size: 20px;
                font-weight: 400;
                horizontal-alignment: left;
                letter-spacing: 0.2px;
                wrap: word-wrap;
            }
            figma-overflow-1-single := Text {
                visible: figma-overflow-1-measure.preferred-height <= figma-overflow-1-single.preferred-height;
                width: parent.width + 2px * ceil(max(0px, self.preferred-width - parent.width) / 2px + 0);
                height: parent.height + 2px * ceil(max(0px, self.preferred-height - parent.height) / 2px + 0.091);
                x: (self.preferred-width - self.width) / 2;
                y: (self.preferred-height - self.height) / 2;
                color: #C3C3C3;
                text: "название трека";
                font-family: "Inter";
                font-size: 20px;
                font-weight: 400;
                horizontal-alignment: center;
                vertical-alignment: center;
                letter-spacing: 0.2px;
            }
            Text {
                visible: !(figma-overflow-1-measure.preferred-height <= figma-overflow-1-single.preferred-height);
                x: 0px;
                width: parent.width;
                height: parent.height + 2px * ceil(max(0px, figma-overflow-1-measure.preferred-height - parent.height) / 2px + 0.091);
                y: (figma-overflow-1-measure.preferred-height - self.height) / 2;
                color: #C3C3C3;
                text: "название трека";
                font-family: "Inter";
                font-size: 20px;
                font-weight: 400;
                horizontal-alignment: left;
                vertical-alignment: center;
                letter-spacing: 0.2px;
                wrap: word-wrap;
            }
        }
        Text {
            x: 25px;
            y: 574px;
            width: 154px;
            height: 16px;
            color: #FFFFFF;
            text: "исполнитель";
            font-family: "Inter";
            font-size: 15px;
            font-weight: 400;
            horizontal-alignment: left;
            letter-spacing: 0.15px;
            wrap: word-wrap;
        }
        Bibleoteka {
            x: 25px;
            y: 28px;
            width: 31px;
            height: 31px;
        }
    }
}
