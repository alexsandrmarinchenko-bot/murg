export component Bibleoteka inherits Rectangle {
    callback clicked();
    preferred-width: 36px;
    preferred-height: 36px;

    // Default / Hover / Pressed appearance from the Figma component set.
    Rectangle {
        x: 0px;
        y: 1px;
        width: 36px;
        height: 35px;
        background: area.pressed ? #2B2B2B : #898989;
        border-radius: area.pressed ? 5px : 7px;
        animate background { duration: 150ms; easing: ease-in-out; }
    }
    Rectangle {
        x: 0px;
        y: 0px;
        width: 34.875px;
        height: 34.875px;
        background: #2B2B2B;
        border-width: area.has-hover && !area.pressed ? 1px : 0px;
        border-color: #FFFFFF;
        border-radius: 5px;
        animate border-width { duration: 150ms; easing: ease-in-out; }
    }
    Rectangle {
        x: area.pressed ? 5px : 6px;
        y: area.pressed ? 7px : 9px;
        width: area.pressed ? 26px : 25px;
        height: area.pressed ? 5px : 3px;
        background: area.pressed ? #FFFFFF : #D9D9D9;
        animate x, y, width, height, background {
            duration: 150ms;
            easing: ease-in-out;
        }
    }
    Rectangle {
        x: area.pressed ? 5px : 6px;
        y: area.pressed ? 15px : 17px;
        width: area.pressed ? 26px : 25px;
        height: area.pressed ? 5px : 3px;
        background: area.pressed ? #FFFFFF : #D9D9D9;
        animate x, y, width, height, background {
            duration: 150ms;
            easing: ease-in-out;
        }
    }
    Rectangle {
        x: area.pressed ? 5px : 6px;
        y: area.pressed ? 23px : 25px;
        width: area.pressed ? 26px : 25px;
        height: area.pressed ? 5px : 3px;
        background: area.pressed ? #FFFFFF : #D9D9D9;
        animate x, y, width, height, background {
            duration: 150ms;
            easing: ease-in-out;
        }
    }
    area := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

export component SettingsButton inherits Rectangle {
    callback clicked();
    preferred-width: 36px;
    preferred-height: 36px;

    Rectangle {
        x: 0px;
        y: 1px;
        width: 36px;
        height: 35px;
        background: area.pressed ? #2B2B2B : #898989;
        border-radius: area.pressed ? 5px : 7px;
        animate background { duration: 150ms; easing: ease-in-out; }
    }
    Rectangle {
        x: 0px;
        y: 0px;
        width: 34.875px;
        height: 34.875px;
        background: #2B2B2B;
        border-width: area.has-hover && !area.pressed ? 1px : 0px;
        border-color: #FFFFFF;
        border-radius: 5px;
        animate border-width { duration: 150ms; easing: ease-in-out; }
    }

    // Use a crisp vector gear instead of separately positioned tooth rectangles.
    // The 27px SVG keeps the outline close to the proportions of the Figma button.
    Image {
        x: 4.5px;
        y: 4.5px;
        width: 27px;
        height: 27px;
        source: Assets.settings_gear;
        image-fit: contain;
        opacity: area.pressed ? 0.0 : 1.0;
        animate opacity { duration: 100ms; easing: ease-in-out; }
    }
    Image {
        x: 4.5px;
        y: 4.5px;
        width: 27px;
        height: 27px;
        source: Assets.settings_gear_pressed;
        image-fit: contain;
        opacity: area.pressed ? 1.0 : 0.0;
        animate opacity { duration: 100ms; easing: ease-in-out; }
    }

    area := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

