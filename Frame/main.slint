// import "fonts/inter-regular.ttf";

global Assets {
    out property <image> unnamed: @image-url("assets/image-49194f4ab8df0950.png");
    out property <image> unnamed-2: @image-url("assets/image-a71d83b2d743a058.png");
    out property <image> polygon-2: @image-url("assets/image-d149f636284e1f21.png");
    out property <image> polygon-1: @image-url("assets/image-2ac634e6766b6d9e.png");
    out property <image> polygon-3: @image-url("assets/image-f8ce3a9d20674783.png");
}

export component Unnamed inherits Rectangle {
    in-out property <float> value: 8;
    callback drag_started();
    callback drag_finished();
    callback changed(float);
    preferred-width: 68px;
    preferred-height: 23px;
    Image {
        height: 5px;
        image-fit: fill;
        source: Assets.unnamed;
        width: 68px;
        x: 0px;
        y: 9px;
    }
    Image {
        height: 23px;
        image-fit: fill;
        source: Assets.unnamed-2;
        width: 23px;
        x: 3px + max(0px, root.width - 26px) * (root.value / 100.0);
        y: 0px;
    }
    area := TouchArea {
        width: parent.width;
        height: parent.height;
        moved => {
            if (self.pressed) {
                root.value = max(0.0, min(100.0,
                    ((self.mouse-x - 11.5px) / max(root.width - 23px, 1px)) * 100.0));
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.drag_started();
            }
            if (event.kind == PointerEventKind.up) {
                root.value = max(0.0, min(100.0,
                    ((self.mouse-x - 11.5px) / max(root.width - 23px, 1px)) * 100.0));
                root.changed(root.value);
                root.drag_finished();
            }
            if (event.kind == PointerEventKind.cancel) {
                root.drag_finished();
            }
        }
    }
}

export component ShkalaVremeni inherits Rectangle {
    in-out property <float> position_seconds: 0;
    in property <float> duration_seconds: 1;
    callback drag_started();
    callback drag_cancelled();
    callback committed(float);
    preferred-width: 1106px;
    preferred-height: 23px;
    Rectangle {
        background: #D9D9D9;
        height: 5px;
        width: parent.width;
        x: 0px;
        y: 9px;
    }
    Rectangle {
        background: #D9D9D9;
        border-radius: 4px;
        height: 23px;
        width: 23px;
        x: 3px + max(0px, root.width - self.width - 3px) *
            min(1.0, max(0.0, root.position_seconds / max(root.duration_seconds, 1.0)));
        y: 0px;
    }
    area := TouchArea {
        width: parent.width;
        height: parent.height;
        moved => {
            if (self.pressed) {
                root.position_seconds = max(0.0, min(root.duration_seconds,
                    ((self.mouse-x - 11.5px) / max(root.width - 23px, 1px)) * root.duration_seconds));
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.drag_started();
            }
            if (event.kind == PointerEventKind.up) {
                root.position_seconds = max(0.0, min(root.duration_seconds,
                    ((self.mouse-x - 11.5px) / max(root.width - 23px, 1px)) * root.duration_seconds));
                root.committed(root.position_seconds);
            }
            if (event.kind == PointerEventKind.cancel) {
                root.drag_cancelled();
            }
        }
    }
}

export enum NextProperty1 { default }
export component Next inherits Rectangle {
    in property <NextProperty1> variant-property-1: NextProperty1.default;
    callback clicked();
    preferred-width: 25px;
    preferred-height: 26px;
    Rectangle {
        background: area.pressed ? #2B2B2B : #898989;
        border-radius: area.pressed ? 5px : 7px;
        animate background, border-radius { duration: 150ms; easing: ease-in-out; }
    }
    Rectangle {
        background: #2B2B2B;
        border-width: area.has-hover && !area.pressed ? 1px : 0px;
        border-color: #FFFFFF;
        animate border-width { duration: 150ms; easing: ease-in-out; }
        border-radius: 5px;
        height: 25px;
        width: 24px;
        x: 0px;
        y: 0px;
    }
    Image {
        height: 14.25px;
        image-fit: fill;
        image-rendering: pixelated;
        source: Assets.polygon-2;
        transform-origin: { x: 0px, y: 0px };
        transform-rotation: 90deg;
        width: 16.454px;
        x: 20.25px;
        y: 5px;
    }
    area := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

