    area := TouchArea {
        width: parent.width;
        height: parent.height;
        moved => {
            if (self.pressed) {
                root.value = max(0.0, min(100.0,
                    ((self.mouse-x - 11.5px) / max(root.width - 23px, 1px)) * 100.0));
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.drag_started();
            }
            if (event.kind == PointerEventKind.up) {
                root.value = max(0.0, min(100.0,
                    ((self.mouse-x - 11.5px) / max(root.width - 23px, 1px)) * 100.0));
                root.changed(root.value);
                root.drag_finished();
            }
            if (event.kind == PointerEventKind.cancel) {
                root.drag_finished();
            }
        }
    }
}

