// import "fonts/inter-regular.ttf";

global Assets {
    out property <image> biblioteca: @image-url("assets/image-d81a3bd1d543f942.png");
    out property <image> icon: @image-url("assets/image-99c1e7fe16e3ea5d.png");
    out property <image> unnamed: @image-url("assets/image-49194f4ab8df0950.png");
    out property <image> unnamed-2: @image-url("assets/image-a71d83b2d743a058.png");
}

export component Bibleoteka inherits Rectangle {
    callback clicked();
    preferred-width: 31px;
    preferred-height: 31px;
    Image {
        height: 31px;
        image-fit: fill;
        image-rendering: pixelated;
        source: Assets.biblioteca;
        width: 31px;
        x: 0px;
        y: 0px;
    }
    Rectangle {
        height: 17px;
        width: 20px;
        x: 5px;
        y: 7px;
        Image {
            height: 18.401px;
            image-fit: fill;
            source: Assets.icon;
            width: 21.648px;
            x: -0.53px;
            y: -0.701px;
        }
    }
    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

export component Unnamed inherits Rectangle {
    in-out property <float> value: 8;
    callback drag_started();
    callback drag_finished();
    callback changed(float);
    preferred-width: 68px;
    preferred-height: 23px;
    Image {
        height: 5px;
        image-fit: fill;
        image-rendering: pixelated;
        source: Assets.unnamed;
        width: 68px;
        x: 0px;
        y: 9px;
    }
    Image {
        height: 23px;
        image-fit: fill;
        image-rendering: pixelated;
        source: Assets.unnamed-2;
        width: 23px;
        x: 3px + max(0px, root.width - 26px) * (root.value / 100.0);
        y: 0px;
    }
    area := TouchArea {
        width: parent.width;
        height: parent.height;
        moved => {
            if (self.pressed) {
                root.value = max(0.0, min(100.0,
                    ((self.mouse-x - 11.5px) / max(root.width - 23px, 1px)) * 100.0));
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.drag_started();
            }
            if (event.kind == PointerEventKind.up) {
                root.value = max(0.0, min(100.0,
                    ((self.mouse-x - 11.5px) / max(root.width - 23px, 1px)) * 100.0));
                root.changed(root.value);
                root.drag_finished();
            }
            if (event.kind == PointerEventKind.cancel) {
                root.drag_finished();
            }
        }
    }
}

export component ShkalaVremeni inherits Rectangle {
    in-out property <float> position_seconds: 0;
    in property <float> duration_seconds: 1;
    callback drag_started();
    callback drag_cancelled();
    callback committed(float);
    preferred-width: 1106px;
    preferred-height: 23px;
    Rectangle {
        background: #D9D9D9;
        height: 5px;
        width: parent.width;
        x: 0px;
        y: 9px;
    }
    Rectangle {
        background: #D9D9D9;
        border-radius: 4px;
        height: 23px;
        width: 23px;
        x: 3px + max(0px, root.width - self.width - 3px) *
            min(1.0, max(0.0, root.position_seconds / max(root.duration_seconds, 1.0)));
        y: 0px;
    }
    area := TouchArea {
        width: parent.width;
        height: parent.height;
        moved => {
            if (self.pressed) {
                root.position_seconds = max(0.0, min(root.duration_seconds,
                    ((self.mouse-x - 11.5px) / max(root.width - 23px, 1px)) * root.duration_seconds));
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.drag_started();
            }
            if (event.kind == PointerEventKind.up) {
                root.position_seconds = max(0.0, min(root.duration_seconds,
                    ((self.mouse-x - 11.5px) / max(root.width - 23px, 1px)) * root.duration_seconds));
                root.committed(root.position_seconds);
            }
            if (event.kind == PointerEventKind.cancel) {
                root.drag_cancelled();
            }
        }
    }
}

export component Demo inherits Window {
    in-out property <string> track_title: "название трека";
    in-out property <string> artist_name: "исполнитель";
    in-out property <float> position_seconds: 0;
    in-out property <float> duration_seconds: 1;
    in-out property <float> volume_percent: 8;
    in-out property <bool> is_playing: false;
    in-out property <image> cover_art;
    in-out property <string> status_message: "";

    callback library_clicked();
    callback previous_clicked();
    callback play_clicked();
    callback next_clicked();
    callback seek_drag_started();
    callback seek_drag_cancelled();
    callback seek_committed(float);
    callback volume_drag_started();
    callback volume_drag_finished();
    callback volume_changed(float);

    preferred-width: 1280px;
    preferred-height: 720px;
    min-width: 480px;
    min-height: 270px;
    background: #202020;
    property <float> ui_scale: min(root.width / 1280px, root.height / 720px);
    Rectangle {
        x: (parent.width - 1280px * root.ui_scale) / 2;
        y: (parent.height - 720px * root.ui_scale) / 2;
        width: 1280px;
        height: 720px;
        transform-scale: root.ui_scale;
        transform-origin: { x: 0px, y: 0px };
        background: #202020;
        clip: true;
        Rectangle {
            x: 25px;
            y: 598px;
            width: 1229px;
            height: 96px;
            FlexboxLayout {
                flex-wrap: no-wrap;
                spacing: 27px;
                alignment: space-between;
                cross-axis-alignment: center;
                Rectangle {
                    width: 96px;
                    height: 96px;
                    background: #D9D9D9;
                    border-radius: 10px;
                    clip: true;
                    Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.cover_art;
                        image-fit: cover;
                    }
                }
                Rectangle {
                    width: 1106px;
                    height: 73px;
                    FlexboxLayout {
                        flex-direction: column;
                        flex-wrap: no-wrap;
                        spacing: 1px;
                        alignment: center;
                        cross-axis-alignment: center;
                        ShkalaVremeni {
                            preferred-width: 1106px;
                            min-width: 0px;
                            cross-axis-self-alignment: stretch;
                            horizontal-stretch: 0;
                            height: 23px;
                            position_seconds <=> root.position_seconds;
                            duration_seconds: root.duration_seconds;
                            drag_started => { root.seek_drag_started(); }
                            drag_cancelled => { root.seek_drag_cancelled(); }
                            committed(seconds) => { root.seek_committed(seconds); }
                        }
                        Rectangle {
                            preferred-width: 1106px;
                            min-width: 0px;
                            cross-axis-self-alignment: stretch;
                            horizontal-stretch: 0;
                            height: 48.5px;
                            Rectangle {
                                x: 0px;
                                y: 10.5px;
                                width: 112px;
                                height: 38px;
                                FlexboxLayout {
                                    flex-wrap: no-wrap;
                                    spacing: 6px;
                                    cross-axis-alignment: center;
                                    Unnamed {
                                        width: 68px;
                                        height: 23px;
                                        value <=> root.volume_percent;
                                        drag_started => { root.volume_drag_started(); }
                                        drag_finished => { root.volume_drag_finished(); }
                                        changed(value) => { root.volume_changed(value); }
                                    }
                                    Image {
                                        width: 38px;
                                        height: 38px;
                                        source: @image-url("assets/image-a7524bd04a5d9478.png");
                                        image-fit: fill;
                                        image-rendering: pixelated;
                                    }
                                }
                            }
                            Rectangle {
                                x: 526px;
                                y: 0px;
                                width: 135px;
                                height: 41px;
                                Image {
                                    x: 0px;
                                    y: 5px;
                                    width: 31px;
                                    height: 31px;
                                    source: @image-url("assets/image-ad9b5a6d06da7dec.png");
                                    image-fit: fill;
                                    image-rendering: pixelated;
                                }
                                Image {
                                    x: 46px;
                                    y: 0px;
                                    width: 43px;
                                    height: 41px;
                                    source: @image-url("assets/image-9e45c6515b00fe78.png");
                                    image-fit: fill;
                                    image-rendering: pixelated;
                                }
                                Image {
                                    x: 104px;
                                    y: 5px;
                                    width: 31px;
                                    height: 31px;
                                    source: @image-url("assets/image-8c4553e8b0d341b7.png");
                                    image-fit: fill;
                                    image-rendering: pixelated;
                                }
                                TouchArea {
                                    x: 0px;
                                    y: 0px;
                                    width: 31px;
                                    height: 41px;
                                    clicked => { root.previous_clicked(); }
                                }
                                TouchArea {
                                    x: 46px;
                                    y: 0px;
                                    width: 43px;
                                    height: 41px;
                                    clicked => { root.play_clicked(); }
                                }
                                TouchArea {
                                    x: 104px;
                                    y: 0px;
                                    width: 31px;
                                    height: 41px;
                                    clicked => { root.next_clicked(); }
                                }
                            }
                            Image {
                                x: 1075px;
                                y: 10px;
                                width: 31px;
                                height: 31px;
                                source: @image-url("assets/image-d81a3bd1d543f942.png");
                                image-fit: fill;
                                image-rendering: pixelated;
                            }
                        }
                    }
                }
            }
        }
        Rectangle {
            x: 25px;
            y: 548px;
            width: 162px;
            height: 23px;
            figma-overflow-1-measure := Text {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                opacity: 0;
                color: #C3C3C3;
                text: root.track_title;
                font-family: "Inter";
                font-size: 20px;
                font-weight: 400;
                horizontal-alignment: left;
                letter-spacing: 0.2px;
                wrap: word-wrap;
            }
            figma-overflow-1-single := Text {
                visible: figma-overflow-1-measure.preferred-height <= figma-overflow-1-single.preferred-height;
                width: parent.width + 2px * ceil(max(0px, self.preferred-width - parent.width) / 2px + 0);
                height: parent.height + 2px * ceil(max(0px, self.preferred-height - parent.height) / 2px + 0.091);
                x: (self.preferred-width - self.width) / 2;
                y: (self.preferred-height - self.height) / 2;
                color: #C3C3C3;
                text: "название трека";
                font-family: "Inter";
                font-size: 20px;
                font-weight: 400;
                horizontal-alignment: center;
                vertical-alignment: center;
                letter-spacing: 0.2px;
            }
            Text {
                visible: !(figma-overflow-1-measure.preferred-height <= figma-overflow-1-single.preferred-height);
                x: 0px;
                width: parent.width;
                height: parent.height + 2px * ceil(max(0px, figma-overflow-1-measure.preferred-height - parent.height) / 2px + 0.091);
                y: (figma-overflow-1-measure.preferred-height - self.height) / 2;
                color: #C3C3C3;
                text: "название трека";
                font-family: "Inter";
                font-size: 20px;
                font-weight: 400;
                horizontal-alignment: left;
                vertical-alignment: center;
                letter-spacing: 0.2px;
                wrap: word-wrap;
            }
        }
        Text {
            x: 25px;
            y: 574px;
            width: 154px;
            height: 16px;
            color: #FFFFFF;
            text: root.artist_name;
            font-family: "Inter";
            font-size: 15px;
            font-weight: 400;
            horizontal-alignment: left;
            letter-spacing: 0.15px;
            wrap: word-wrap;
        }
        Bibleoteka {
            x: 25px;
            y: 28px;
            width: 31px;
            height: 31px;
            clicked => { root.library_clicked(); }
        }
        Text {
            x: 25px;
            y: 64px;
            width: min(parent.width - 50px, 900px);
            height: 20px;
            visible: root.status_message != "";
            text: root.status_message;
            color: #C3C3C3;
            font-family: "Inter";
            font-size: 11px;
            overflow: elide;
            max-lines: 1;
        }
    }
}
