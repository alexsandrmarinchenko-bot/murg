}

export enum BackProperty1 { default }
export component Back inherits Rectangle {
    in property <BackProperty1> variant-property-1: BackProperty1.default;
    callback clicked();
    preferred-width: 26px;
    preferred-height: 26px;
    Rectangle {
        background: area.pressed ? #2B2B2B : #898989;
        border-radius: area.pressed ? 5px : 7px;
        animate background, border-radius { duration: 150ms; easing: ease-in-out; }
    }
    Rectangle {
        background: #2B2B2B;
        border-width: area.has-hover && !area.pressed ? 1px : 0px;
        border-color: #FFFFFF;
        animate border-width { duration: 150ms; easing: ease-in-out; }
        border-radius: 5px;
        height: 25px;
        width: 25px;
        x: 0px;
        y: 0px;
    }
    Image {
        height: 19px;
        image-fit: fill;
        image-rendering: pixelated;
        source: Assets.polygon-3;
        transform-origin: { x: 0px, y: 0px };
        transform-rotation: -90deg;
        width: 19px;
        x: 3px;
        y: 22px;
    }
    area := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

