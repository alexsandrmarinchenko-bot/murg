// import "fonts/inter-regular.ttf";

global Assets {
    out property <image> unnamed: @image-url("assets/image-49194f4ab8df0950.png");
    out property <image> unnamed-2: @image-url("assets/image-a71d83b2d743a058.png");
    out property <image> polygon-2: @image-url("assets/image-d149f636284e1f21.png");
    out property <image> polygon-1: @image-url("assets/image-2ac634e6766b6d9e.png");
    out property <image> polygon-3: @image-url("assets/image-f8ce3a9d20674783.png");
}

export component Unnamed inherits Rectangle {
    preferred-width: 68px;
    preferred-height: 23px;
    Image {
        height: 5px;
        image-fit: fill;
        image-rendering: pixelated;
        source: Assets.unnamed;
        width: 68px;
        x: 0px;
        y: 9px;
    }
    Image {
        height: 23px;
        image-fit: fill;
        image-rendering: pixelated;
        source: Assets.unnamed-2;
        width: 23px;
        x: 3px;
        y: 0px;
    }
}

