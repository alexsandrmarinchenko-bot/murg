            }
        }
        Rectangle {
            x: 44px;
            y: 624px;
            width: 162px;
            height: 23px;
            figma-overflow-1-measure := Text {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                opacity: 0;
                color: #C3C3C3;
                text: "название трека";
                font-family: "Inter";
                font-size: 20px;
                font-weight: 400;
                horizontal-alignment: left;
                letter-spacing: 0.2px;
                wrap: word-wrap;
            }
            figma-overflow-1-single := Text {
                visible: figma-overflow-1-measure.preferred-height <= figma-overflow-1-single.preferred-height;
                width: parent.width + 2px * ceil(max(0px, self.preferred-width - parent.width) / 2px + 0);
                height: parent.height + 2px * ceil(max(0px, self.preferred-height - parent.height) / 2px + 0.091);
                x: (self.preferred-width - self.width) / 2;
                y: (self.preferred-height - self.height) / 2;
                color: #C3C3C3;
                text: "название трека";
                font-family: "Inter";
                font-size: 20px;
                font-weight: 400;
                horizontal-alignment: center;
                vertical-alignment: center;
                letter-spacing: 0.2px;
            }
            Text {
                visible: !(figma-overflow-1-measure.preferred-height <= figma-overflow-1-single.preferred-height);
                x: 0px;
                width: parent.width;
                height: parent.height + 2px * ceil(max(0px, figma-overflow-1-measure.preferred-height - parent.height) / 2px + 0.091);
                y: (figma-overflow-1-measure.preferred-height - self.height) / 2;
                color: #C3C3C3;
                text: "название трека";
                font-family: "Inter";
                font-size: 20px;
                font-weight: 400;
                horizontal-alignment: left;
                vertical-alignment: center;
                letter-spacing: 0.2px;
                wrap: word-wrap;
            }
        }
        Image {
            x: 10px;
